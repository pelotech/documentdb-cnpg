# versions.env - pinned inputs; bumping any value re-runs the full verify gate.
DOCUMENTDB_TAG=v0.114-0                     # documentdb/documentdb release tag (must be a real git tag)
ICU_VERSION=77-1                            # unicode-org/icu release tag (icu4c-77_1-src.tgz)
ICU_MAJOR=77                                # must equal every hardened base's ICU major (guard checks this)
ENGINE_PG_MAJORS="17 18"                    # Postgres majors we build documentdb-embedded ENGINE images for
IMAGEVOL_PG_MAJOR=18                        # ImageVolume extension is PG18-only (needs extension_control_path, a PG18 GUC)
DEFAULT_PG_MAJOR=18                         # default major for a bare build.sh / verify.sh run
IMAGE_REPO=ghcr.io/pelotech/documentdb-cnpg   # <registry>/documentdb-cnpg; build scripts + CI assert non-empty

# One hardened base per PG major, tag@digest: digest pins the image (docker/kubelet
# resolve by digest); the tag is required because CNPG rejects a digest-only imageName. The ICU-drift
# guard re-checks each base's ICU major on every run.
HARDENED_BASE_17=reg.mini.dev/cloudnative-pg-postgresql-fips:17@sha256:ebbe25cd0678e0b0bf9d700587a9829074628d2ed1a1a9de254248d46aeb364a
HARDENED_BASE_18=reg.mini.dev/cloudnative-pg-postgresql-fips:18.4@sha256:9bbeaf6f3dc096cea12a5ff5112ffa81e76c9c4c86b49d765579ed71ea55db31

# Rust builder for the documentdb-gw image; trixie glibc 2.41 <= base 2.43, OpenSSL 3, ABI-safe.
RUST_BUILDER=docker.io/library/rust:1-trixie@sha256:1bcff4befb740599103a2c7cb51058e14479b2e35e3a34a3f0dc4ede09927488
