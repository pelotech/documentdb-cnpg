# versions.env - values shared across all artifacts. Per-artifact pins (documentdb tag, ICU,
# hardened bases, rust builder) live in build/<artifact>/pins.env and are kept in lockstep by
# build/common/check-pins.sh.
IMAGE_REPO=ghcr.io/pelotech/documentdb-cnpg   # <registry>/documentdb-cnpg; build scripts + CI assert non-empty
DEFAULT_PG_MAJOR=18                           # default major for a bare build/verify run
