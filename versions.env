# versions.env - pinned inputs. Bump deliberately; every bump re-runs the full verify gate.
DOCUMENTDB_TAG=v0.114-0                     # documentdb/documentdb release tag (latest actual release; must be a real git tag). The spike verified source HEAD (default_version 0.116-0), which is not yet a release; the verify gate re-proves whatever tag is pinned here.
ICU_VERSION=77-1                            # unicode-org/icu release tag (icu4c-77_1-src.tgz)
ICU_MAJOR=77                                # must equal the hardened base's ICU major (guard checks this)
PG_MAJOR=18
HARDENED_BASE=reg.mini.dev/cloudnative-pg-postgresql-fips:18.4@sha256:9bbeaf6f3dc096cea12a5ff5112ffa81e76c9c4c86b49d765579ed71ea55db31   # tag@digest: pinned by digest for reproducibility (docker/kubelet resolve by digest); the :18.4 tag is required because CNPG rejects a digest-only imageName. The ICU-drift guard re-checks the base ICU major on every run.
IMAGE_REPO=ghcr.io/pelotech/documentdb-cnpg-extension   # <registry>/documentdb-cnpg-extension; build.sh and CI assert it is non-empty
