# Bake the documentdb extension into an upstream CloudNativePG standard-trixie image,
# producing a runnable engine image (no ImageVolume). Debian/PGDG layout:
# pkglibdir=/usr/lib/postgresql/${M}/lib, sharedir=/usr/share/postgresql/${M}. Copy only the
# documentdb + dependency extension modules (not base PG modules); set their RPATH to
# pkglibdir + /usr/lib/documentdb-system so inter-module + bundled deps resolve without
# touching the system ldconfig cache; bundle the non-core runtime deps (postgis' GEOS/PROJ/
# GDAL tree etc.) that the base does not ship into /usr/lib/documentdb-system.
ARG DDB_BUILDER
ARG BASE
ARG PG_MAJOR

FROM ${DDB_BUILDER} AS deps
ARG PG_MAJOR
COPY --from=deb-stage / /tmp/deb/
COPY build/common/gen_system.sh /gen_system.sh
RUN dpkg -i /tmp/deb/*.deb || (apt-get update && apt-get -y -f install && dpkg -i /tmp/deb/*.deb)
RUN apt-get update && apt-get install -y --no-install-recommends patchelf >/dev/null
RUN set -euo pipefail; \
    pkglib="$(pg_config --pkglibdir)"; \
    test "$pkglib" = "/usr/lib/postgresql/${PG_MAJOR}/lib"; \
    mkdir -p /out/lib /out/share /out/system; \
    for so in pg_documentdb_core pg_documentdb pg_documentdb_extended_rum pg_documentdb_extended_rum_core \
              postgis-3 pg_cron vector rum; do \
      cp -L "$pkglib/$so.so" /out/lib/ 2>/dev/null || echo "note: $so.so absent"; \
    done; \
    cp -rL "$(pg_config --sharedir)/extension" /out/share/extension; \
    cp -rL "$(pg_config --sharedir)/contrib"   /out/share/contrib; \
    PKGLIB="$pkglib" bash /gen_system.sh; \
    patchelf --force-rpath --set-rpath "${pkglib}:/usr/lib/documentdb-system" /out/lib/*.so; \
    for f in /out/system/*; do patchelf --force-rpath --set-rpath '/usr/lib/documentdb-system' "$f" 2>/dev/null || true; done

FROM ${BASE} AS engine
ARG PG_MAJOR
USER root
# Assert the Debian/PGDG layout matches our assumption; build fails if the base changes it.
RUN test "$(pg_config --pkglibdir)" = "/usr/lib/postgresql/${PG_MAJOR}/lib" \
 && test "$(pg_config --sharedir)"  = "/usr/share/postgresql/${PG_MAJOR}"
COPY --from=deps /out/lib/            /usr/lib/postgresql/${PG_MAJOR}/lib/
COPY --from=deps /out/share/extension /usr/share/postgresql/${PG_MAJOR}/extension/
COPY --from=deps /out/share/contrib   /usr/share/postgresql/${PG_MAJOR}/contrib/
COPY --from=deps /out/system/         /usr/lib/documentdb-system/
RUN set -eu; \
    rm -f /usr/lib/documentdb-system/pg_documentdb*; \
    for so in /usr/lib/postgresql/${PG_MAJOR}/lib/pg_documentdb.so /usr/lib/postgresql/${PG_MAJOR}/lib/postgis-3.so; do \
      if ldd "$so" | grep -q 'not found'; then echo "unresolved deps in $so"; ldd "$so"; exit 1; fi; \
    done; \
    echo "engine bake: pg_documentdb.so + postgis-3.so fully resolved"
USER 26
