# Stage A: build the DocumentDB pg extension .deb for the upstream CNPG base.
#
# The builder (DDB_BUILDER) is upstream's packaging/deb/Dockerfile-deb image on
# debian:trixie, the same distro and PGDG packages as the ghcr.io/cloudnative-pg
# *-standard-trixie bases, so the extension links the distro ICU (ICU_MAJOR) that
# the base's Postgres also links. We neutralize upstream's override_dh_auto_test
# (it runs the full `make check` regression suite) so `debuild` stays fast; the
# acceptance gate is test/verify*.sh. A build-time objdump guard asserts the
# extension links ucol_*_${ICU_MAJOR} and no other ICU major.
ARG DDB_BUILDER
FROM ${DDB_BUILDER} AS builder
SHELL ["/bin/bash", "-c"]
ARG ICU_MAJOR
ARG DOCUMENTDB_TAG
ARG PG_MAJOR=18

# 1. Assert the builder's ICU is the pinned major; fail loudly if the distro moved.
RUN set -euo pipefail; \
    apt-get update && apt-get install -y --no-install-recommends binutils; \
    triplet="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    readlink -f "/usr/lib/${triplet}/libicui18n.so" | grep -q "\.so\.${ICU_MAJOR}\." \
      || { echo "builder ICU is not ${ICU_MAJOR}"; ls -l "/usr/lib/${triplet}"/libicui18n.so*; exit 1; }

WORKDIR /build

# 2. Remove upstream's override_dh_auto_test target *and its whole tab-indented recipe*.
#    A line-only delete would leave the recipe body attached and still run `make check`.
#    The trailing (?:\n|\z) also consumes the final recipe line when rules has no trailing newline.
RUN set -euo pipefail; \
    perl -0pi -e 's/^override_dh_auto_test:\n(?:\t.*(?:\n|\z))*//m' debian/rules; \
    ! grep -q '^override_dh_auto_test:' debian/rules; \
    ! grep -q 'make check' debian/rules

# 3. Build the .deb. nocheck makes the default dh_auto_test a no-op; noautodbgsym keeps
#    the output to a single package. OS=deb13 matches the trixie builder base.
RUN set -euo pipefail; \
    DEB_BUILD_OPTIONS="nocheck noautodbgsym" OS=deb13 DOCUMENTDB_VERSION="${DOCUMENTDB_TAG#v}" \
      /usr/local/bin/packaging-entrypoint.sh

# 4. Build-time correctness guard: read the core .so out of the produced .deb and assert
#    it links ICU ${ICU_MAJOR} (ucol_getSortKey_${ICU_MAJOR} present) and carries no other
#    ICU major's collation symbol. (`ucol_*_NN` only; a static Intel decimal-math
#    __bid_round256_58_76 is not ICU.)
RUN set -euo pipefail; \
    pkglib="/usr/lib/postgresql/${PG_MAJOR}/lib"; \
    core_so=""; \
    for d in /output/*.deb; do \
      x="$(mktemp -d)"; dpkg-deb -x "$d" "$x"; \
      if [ -f "${x}${pkglib}/pg_documentdb_core.so" ]; then core_so="${x}${pkglib}/pg_documentdb_core.so"; break; fi; \
    done; \
    test -n "$core_so" || { echo "pg_documentdb_core.so not found in any /output/*.deb"; ls -la /output; exit 1; }; \
    syms="$(objdump -T "$core_so")"; \
    grep -q "ucol_getSortKey_${ICU_MAJOR}" <<<"$syms" || { echo "missing ucol_getSortKey_${ICU_MAJOR} (not linked against ICU ${ICU_MAJOR})"; exit 1; }; \
    other="$(grep -oE 'ucol_[a-zA-Z]+_[0-9]+' <<<"$syms" | grep -vE "_${ICU_MAJOR}\$" | sort -u || true)"; \
    if [ -n "$other" ]; then echo "found non-ICU-${ICU_MAJOR} collation symbols in $core_so:"; echo "$other"; exit 1; fi; \
    echo "ICU-${ICU_MAJOR} link verified on $(basename "$core_so")"

# Export just the .deb(s).
FROM scratch
COPY --from=builder /output/*.deb /
