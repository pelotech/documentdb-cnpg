From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Gomez <emmanuel@gomez.io>
Date: Thu, 5 Nov 2026 10:34:10 -0800
Subject: [PATCH 1/3] build(gw): add postgres-openssl for outbound Postgres TLS

Add the `postgres-openssl` crate (0.5) so the gateway can build a
`MakeTlsConnector` for its backend PostgreSQL connections. It reuses the
existing `openssl` 0.10 / `openssl-sys` 0.9 already in the tree (no
duplicate, no vendored OpenSSL), keeping the system-OpenSSL link.

Refreshed for DOCUMENTDB_TAG=v1.0-0.
---
 Cargo.lock                         | 13 +++++++++++++
 Cargo.toml                         |  1 +
 documentdb_gateway_core/Cargo.toml |  1 +
 3 files changed, 15 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index 7a75ddb4..e7217079 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -624,6 +624,7 @@ dependencies = [
  "nacelle",
  "once_cell",
  "openssl",
+ "postgres-openssl",
  "rand 0.10.2",
  "regex",
  "scc",
@@ -1908,6 +1909,18 @@ version = "1.14.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "3d20d5497ef88037a52ff98267d066e7f11fcc5e99bbfbd58a42336193aacec3"
 
+[[package]]
+name = "postgres-openssl"
+version = "0.5.3"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "06743eefaa1a5c0ef2ccb6d9abf6528790a229eabd62ddcabf9b2a3aeff09fa4"
+dependencies = [
+ "openssl",
+ "tokio",
+ "tokio-openssl",
+ "tokio-postgres",
+]
+
 [[package]]
 name = "postgres-protocol"
 version = "0.6.12"
diff --git a/Cargo.toml b/Cargo.toml
index 8e6d447d..2fbc49a6 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -56,6 +56,7 @@ mongodb = { version = "3.6.0", default-features = false, features = [
 ] }
 once_cell = "1.21.4"
 openssl = "0.10.81"
+postgres-openssl = "0.5"
 opentelemetry = { version = "0.32.0", features = ["metrics", "trace"] }
 opentelemetry-otlp = { version = "0.32.0", features = ["grpc-tonic", "metrics", "trace"] }
 opentelemetry_sdk = { version = "0.32.0", features = ["rt-tokio", "metrics", "trace"] }
diff --git a/documentdb_gateway_core/Cargo.toml b/documentdb_gateway_core/Cargo.toml
index de154017..e2202ed6 100644
--- a/documentdb_gateway_core/Cargo.toml
+++ b/documentdb_gateway_core/Cargo.toml
@@ -37,6 +37,7 @@ metrics.workspace = true
 nacelle.workspace = true
 once_cell.workspace = true
 openssl.workspace = true
+postgres-openssl.workspace = true
 rand.workspace = true
 regex.workspace = true
 scc.workspace = true
