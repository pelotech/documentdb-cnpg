+    /// Populate the backend passwords from `DOCUMENTDB_PG_PASSWORD_FILE`, if set.
+    /// One trailing line ending is trimmed. The value fills both
+    /// `postgres_data_user_password` and `postgres_system_user_password` (one
+    /// secret for the data and system pools, which use separate roles).
+    fn apply_pg_password_file(config: &mut Self) -> Result<()> {
+        let Some(path) = read_env(env_keys::PG_PASSWORD_FILE)? else {
+            return Ok(());
+        };
+
+        let raw = std::fs::read_to_string(&path).map_err(|e| {
+            DocumentDBError::internal_error(format!(
+                "Failed to read {} {}: {}",
+                env_keys::PG_PASSWORD_FILE,
+                path,
+                e
+            ))
+        })?;
+
+        // Trim one trailing line ending only; do not `trim()` the value (a
+        // password may contain leading/inner/trailing spaces, and secret files
+        // often append '\n' or '\r\n').
+        let mut password = raw.as_str();
+        if let Some(stripped) = password.strip_suffix('\n') {
+            password = stripped;
+        }
+        if let Some(stripped) = password.strip_suffix('\r') {
+            password = stripped;
+        }
+
+        config.postgres_data_user_password = Some(password.to_owned());
+        config.postgres_system_user_password = Some(password.to_owned());
+        Ok(())
+    }
