+#[test]
+fn pg_password_file_populates_data_user_password() {
+    // DOCUMENTDB_PG_PASSWORD_FILE is the sanctioned out-of-band
+    // credential path (URL/JSON/PGPASSWORD passwords stay rejected).
+    // The file's single trailing newline must be trimmed so the SCRAM
+    // secret matches exactly what CNPG stored.
+    let pw = TempPath::with_content(b"s3cret\n");
+    let pw_path = pw.path().to_str().unwrap().to_owned();
+    let _guard = crate::testing::EnvGuard::set_many([
+        (env_keys::PG_PASSWORD_FILE, pw_path.as_str()),
+        (env_keys::LISTEN_ADDR, ""),
+        (env_keys::TLS_CERT_FILE, ""),
+        (env_keys::TLS_KEY_FILE, ""),
+        (env_keys::TLS_AUTO_GENERATE, ""),
+        (env_keys::PG_URL_FILE, ""),
+        ("PGPASSWORD", ""),
+    ]);
+    let loaded = DocumentDBSetupConfiguration::from_env_with_optional_json(None)
+        .expect("password-file load must succeed");
+    assert_eq!(
+        loaded.postgres_data_user_password.as_deref(),
+        Some("s3cret"),
+        "DOCUMENTDB_PG_PASSWORD_FILE must populate postgres_data_user_password (newline trimmed)"
+    );
+}
