+    #[test]
+    fn make_pg_tls_connector_with_valid_ca_is_ok() {
+        let ca = TempCaFile::new(TEST_CA_PEM);
+        let result = make_pg_tls_connector(Some(ca.path_str()));
+        assert!(
+            result.is_ok(),
+            "a valid PEM CA file must build a TLS connector: {:?}",
+            result.err()
+        );
+    }
+
+    #[test]
+    fn make_pg_tls_connector_with_missing_ca_is_err() {
+        let result =
+            make_pg_tls_connector(Some("/no/such/documentdb-gw-missing-ca-file.pem"));
+        assert!(
+            result.is_err(),
+            "a non-existent CA path must fail closed rather than silently skip verification"
+        );
+    }
+
+    #[test]
+    fn make_pg_tls_connector_with_none_uses_system_roots() {
+        // Documented `None` behavior: fall back to the OpenSSL default
+        // trust store with PEER verification still enforced (no CA
+        // override, and crucially NOT a verification bypass). Building the
+        // connector must succeed so an operator relying on system CA
+        // bundles does not need to supply DOCUMENTDB_PG_TLS_CA_FILE.
+        let result = make_pg_tls_connector(None);
+        assert!(
+            result.is_ok(),
+            "None must build a connector using system default roots: {:?}",
+            result.err()
+        );
+    }
