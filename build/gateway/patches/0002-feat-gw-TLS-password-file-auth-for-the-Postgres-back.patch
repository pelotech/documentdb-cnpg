+#[test]
+fn json_system_user_password_is_not_deserialized() {
+    // `postgres_system_user_password` carries #[serde(skip_deserializing)],
+    // so a hand-edited SetupConfiguration.json cannot inject a system-pool
+    // credential that would bypass reject_password_in_config (which only
+    // inspects the data-user field). The field must stay None regardless of
+    // any JSON value; it is populated solely by apply_pg_password_file from
+    // DOCUMENTDB_PG_PASSWORD_FILE.
+    let json = r#"{
