+/// OpenSSL TLS connector for outbound `PostgreSQL` connections, with
+/// `SslVerifyMode::PEER`. With `Some(ca)` the PEM file is the trust anchor and a
+/// bad path fails closed; with `None` the OpenSSL default trust store is used.
+/// Peer verification is always on. Hostname verification is done by
+/// `postgres-openssl`, so together with `pg_configuration`'s `SslMode::Require`
+/// this is verify-full-equivalent.
+///
+/// # Errors
+///
+/// Returns an error if the OpenSSL context cannot be created or the CA file
+/// cannot be loaded.
+pub fn make_pg_tls_connector(ca: Option<&str>) -> Result<MakeTlsConnector> {
+    let mut builder = SslConnector::builder(SslMethod::tls_client()).map_err(|e| {
+        DocumentDBError::internal_error(format!("Failed to create PostgreSQL TLS connector: {e}"))
+    })?;
+
+    if let Some(ca_path) = ca {
+        builder.set_ca_file(ca_path).map_err(|e| {
+            DocumentDBError::internal_error(format!(
+                "Failed to load PostgreSQL TLS CA file {ca_path}: {e}"
+            ))
+        })?;
+    }
+
+    // Explicit even though PEER is the default, so it cannot silently regress.
+    builder.set_verify(SslVerifyMode::PEER);
+
+    Ok(MakeTlsConnector::new(builder.build()))
+}
