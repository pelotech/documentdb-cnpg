{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": false,
  "include-v-in-release-name": false,
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "build/engine":       { "release-type": "simple", "component": "engine" },
    "build/imagevol":     { "release-type": "simple", "component": "imagevol" },
    "build/gateway":      { "release-type": "simple", "component": "gateway", "extra-files": ["charts/documentdb-gw/Chart.yaml"] },
    "charts/documentdb-gw": { "release-type": "helm", "component": "documentdb-gw-chart" }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "build", "section": "Build" },
    { "type": "ci", "section": "CI" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests" },
    { "type": "chore", "section": "Chores" }
  ]
}
